{                                                                      
  "$schema": "https://raw.githubusercontent.com/JanDeDobbeleer/oh-my-posh/main/themes/schema.json",                                                                                                                  
  "upgrade": {                                                         
    "source": "cdn",                                                   
    "interval": "168h",                                                
    "auto": false,                                                     
    "notice": false                                                    
  },                                                                   
  "palette": {                                                         
        "pink": "#EA78cb",                                             
        "mauve": "#8839EF",                                                                                                                  
        "base": "#EFF1F5",                                             
        "blue": "#1E66F5",                                             
        "green": "#40A02B",                                                                                                                                                                                                                                                                 
        "red": "#D20F39",                                              
        "teal": "#179299",                                             
        "flamingo": "#DD7878",                                         
        "maroon": "#E64553",                                           
        "peach": "#FE650B",                                            
        "sapphire": "#209FB5",                                         
        "surface0": "#CCD0DA",                                         
        "surface1": "#BCC0CC",                                         
        "text": "#4C4F69",                                             
        "mantle": "#E6E9EF"                                                                                                                                                          
  },                                                                   
  "blocks": [                                                          
    {                                                                                                                                                                                 
      "type": "prompt",                                                
      "alignment": "left",                                             
      "segments": [                                                    
        {                                                              
          "background": "p:mauve",                                     
          "foreground": "p:mantle",                                    
          "properties": {                                              
            "display_host": false                                                                                                            
          },                                                                                                                                                                                                       
          "style": "diamond",                                                                                                                
          "template": "{{if .Root}} \uf0e7 {{.UserName}} {{else}} {{.UserName}} {{end}}",                                                                                                                                                                                                   
          "type": "session"                                                                                                                   
        },                                                             
        {                                                              
          "background": "p:blue",                                      
          "foreground": "p:mantle",                                    
          "powerline_symbol": "\ue0b0",                                
          "properties": {                                              
            "folder_icon": "\uf115",                                   
            "folder_separator_icon": " \ue0b1 ",                       
            "max_depth": 2,                                                                                                                                                          
            "style": "agnoster_short"                                                                                                                                                
          },                                                           
          "style": "powerline",                                                                                                                                                                                                                                                                                                                                              
          "template": " {{ .Path }} ",                                 
          "type": "path"                                               
        },                                                             
        {                                                              
          "properties": {                                                                                                                    
            "branch_icon": "\uE0A0 ",                                  
            "fetch_stash_count": true,                                                                                                                                                                                                                                                      
            "fetch_status": true                                                                                                              
          },                                                                                                                                                                                                       
          "trailing_diamond": "\ue0b0",                                                                                                                                                                            
          "template": " {{ .UpstreamIcon }}{{ .HEAD }}{{if .BranchStatus }} \ue0b1 {{ .BranchStatus }} {{ end }}{{ if .Working.Changed }}\ue0b1  {{ .Working.String }}{{ end }}{{ if and (.Working.Changed) (.Staging.Changed) }} |{{ end }}{{ if .Staging.Changed }}\ue0b1  {{ .Staging.String }}{{ end }}{{ if gt .StashCount 0 }} \ue0b1  {{ .StashCount }} {{ end }}",
          "foreground": "p:blue",                                                                        
          "background": "p:surface0",                                                                     
          "type": "git",                     
          "style": "diamond"                 
        },                                   
        {                                                                                                
          "background": "p:mantle",                                                                                                                                                  
          "foreground": "p:text`",                                                                                                                                                                                                                                                                                                                                           
          "trailing_diamond": "\ue0b0",                                                                                                                                              
          "style": "diamond",                       
          "type": "os"                              
        }                                           
      ]                                             
    }                                               
  ],                                                
  "version": 3,                                     
  "final_space": true                               
}
